# --- App ---
APP_NAME="ClearBid NJ API"
ENV=dev
API_V1_PREFIX=/api/v1
DEFAULT_TZ=America/New_York

# --- Base de datos (async, asyncpg) ---
DATABASE_URL=postgresql+asyncpg://clearbid:clearbid@localhost:5432/clearbid_nj
DB_ECHO=false

# --- JWT (CAMBIAR en producción) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- 2FA / OTP ---
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Rate limiting auth/2FA ---
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60

# --- Proveedores externos: stub (por defecto) o real ---
SMS_PROVIDER=stub
PUSH_PROVIDER=stub
OAUTH_PROVIDER_MODE=stub

# Credenciales reales (solo si provider != stub)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# FACEBOOK_APP_ID=
